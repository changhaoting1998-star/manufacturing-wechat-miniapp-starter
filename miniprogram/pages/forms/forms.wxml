<view class="page">
  <view class="card">
    <text class="card-title">班前安全确认</text>
    <text class="label">设备状态</text>
    <input class="input" value="{{equipment}}" bindinput="equipmentInput" placeholder="正常／需检查" />
    <text class="label">补充说明</text>
    <textarea class="input" value="{{note}}" bindinput="noteInput" placeholder="仅填写完成工作所需的信息" />
    <button class="button" bindtap="submit">提交表单</button>
    <view class="status" wx:if="{{status}}">{{status}}</view>
  </view>
</view>
