<view class="page">
  <view class="card">
    <text class="card-title">申请使用</text>
    <text class="card-copy">填写组织发放的员工编号。微信身份由云函数读取，不由客户端提交。</text>
    <text class="label">员工编号</text>
    <input class="input" value="{{employeeCode}}" bindinput="codeInput" placeholder="例如 DEMO-002" />
    <text class="label">显示姓名</text>
    <input class="input" value="{{displayName}}" bindinput="nameInput" placeholder="例如 周宁" />
    <button class="button" bindtap="submit">提交申请</button>
    <view class="status" wx:if="{{status}}">{{status}}</view>
  </view>
</view>
